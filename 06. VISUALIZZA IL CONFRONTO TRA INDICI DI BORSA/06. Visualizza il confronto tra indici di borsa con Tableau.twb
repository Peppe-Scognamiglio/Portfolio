          <zone h='16319' id='15' param='horz' type-v2='layout-flow' w='98828' x='586' y='50000'>
            <zone forceUpdate='true' h='16059' id='16' type-v2='text' w='34065' x='659' y='50130'>
              <formatted-text>
                <run bold='true' fontcolor='#000000'>ANNO 2018</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Valori anomali: </run>
                <run fontcolor='#555555'>Valori sostanzialmente negativi in T4, in particolare nei mesi di Ottobre e Dicembre.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Motivazione: </run>
                <run fontcolor='#555555'>Aumento dei tassi di interesse da parte della FED; Guerra commerciale tra USA e Cina</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Medie:</run>
                <run fontcolor='#000000'>Æ </run>
                <run>Medie negative </run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone forceUpdate='true' h='16059' id='17' type-v2='text' w='32308' x='34724' y='50130'>
              <formatted-text>
                <run bold='true' fontcolor='#000000'>ANNO 2020</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Valori anomali: </run>
                <run>Si rileva l&apos;alternarsi di valori molto positivi ed altri molto negativi 
</run>
                <run bold='true' fontcolor='#000000'>Motivazione: </run>
                <run>Covid-19 e reazione dell&apos;economia
</run>
                <run bold='true' fontcolor='#000000'>Medie e volatilità:</run>
                <run fontcolor='#000000'>Æ </run>
                <run>Le medie risultano più basse rispetto a quelle usuali e le volatilità più elevate, ad eccezione della media del NASDAQ che resta pressocché invariata</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone forceUpdate='true' h='16059' id='18' type-v2='text' w='32308' x='67032' y='50130'>
              <formatted-text>
                <run bold='true' fontcolor='#000000'>ANNO 2022</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Valori anomali: </run>
                <run>Si rilevano valori negativi nel secondo trimestre, in particolarer nei mesi di Aprile e Giugno.
</run>
                <run bold='true' fontcolor='#000000'>Motivazione: </run>
                <run>Aumento dei tassi di interesse e invasionne russa in Ucraina con conseguente crisi energetica
</run>
                <run bold='true' fontcolor='#000000'>Medie e volatilità: </run>
                <run>Medie negative e volatilità più elevate rispetto al normale</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='background-color' value='#d4d4d4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
